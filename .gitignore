# Dependências
node_modules/

# Variáveis de ambiente.
# No Vite, tudo que começa com VITE_ é embutido no bundle e fica visível no
# navegador — então estes arquivos nunca devem guardar segredo de verdade.
# Ainda assim ficam fora do versionamento, por conterem configuração de ambiente.
.env
.env.*
.env*
!.env.example

# Build do Vite
dist/
dist-ssr/
*.local

# Deploy
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
